	var klOutput struct {
		Reports []struct {
			FilePath   string `json:"FilePath"`
			Diagnostic struct {
				Message string `json:"Message"`
			} `json:"Diagnostic"`
			Check string `json:"Check"`
			Remediation string `json:"Remediation"`
		} `json:"Reports"`
	}

	if err := json.Unmarshal(data, &klOutput); err == nil {
